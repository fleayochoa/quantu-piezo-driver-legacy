            (circle 40500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c131.6))
          (noconnect (pad c131.6))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c131.6))
          (noconnect (pad c131.6))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c131.6))
          (noconnect (pad c131.6))
        )
        (padSet (footLayer Inner)
          (clearance (pad c131.6))
          (connect (pad c131.6))
          (noconnect (pad c131.6))
        )
        (padSet (footLayer Bottom)
          (connect (pad c131.6))
          (noconnect (pad c131.6))
        )
      )
    ); End of padstacks
