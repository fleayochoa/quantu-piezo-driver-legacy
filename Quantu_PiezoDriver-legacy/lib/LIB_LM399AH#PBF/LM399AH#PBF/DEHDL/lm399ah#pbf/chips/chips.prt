      PINUSE='UNSPEC';
    '+_2':
      PIN_NUMBER='(3)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    '-_2':
      PIN_NUMBER='(4)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
  END_PIN;
  BODY
    PART_NAME='LM399AH#PBF';
    PHYS_DES_PREFIX='IC';
    NO_LOAD_CHECK='TRUE';
    PIN_COUNT='4';
    BODY_NAME='LM399AH#PBF';
    JEDEC_TYPE='LM399AHPBF';
  END_BODY;
